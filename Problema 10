#include <stdio.h>

int numero;
int positivos = 0, negativos = 0, nulos = 0;

int main()
{
    for(int i = 1; i <= 100; i++)
    {
        printf("Introduce el numero %d:\n", i);
        scanf("%d", &numero);

        if(numero > 0)
        {
            positivos++;
        }
        else if(numero < 0)
        {
            negativos++;
        }
        else
        {
            nulos++;
        }
    }

    printf("\nResultados:\n");
    printf("Positivos: %d\n", positivos);
    printf("Negativos: %d\n", negativos);
    printf("Nulos: %d\n", nulos);

    return 0;
}
