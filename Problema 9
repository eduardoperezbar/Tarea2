#include <stdio.h>
int resultado, contador, num1;
int main()
{
    printf("Introduce un numero\n");
    scanf("%d",&num1); 
    for(contador = 1; contador<= 10;)
    {
        resultado = contador * num1; 
        printf("%d x %d = %d\n", num1, contador, resultado);
        contador++;
    }
    return 0;
}
