#include <stdio.h>
int producto = 1, contador, numero;
int main()
{
    printf("Ingresa el numero hasta el cual quieres el producto: ");
    scanf("%d", &numero);
    for(contador = 1; contador <= numero;)
    {
        producto = producto * contador;
        contador++;
    }
    printf("El producto es %d\n", producto);
    return 0;
}
